# DashScope / Bailian credentials (https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=sk-your-key

# Optional. Leave it EMPTY unless a model you use really needs the
# workspace-specific endpoint -- setting it rewrites the SDK base URLs to
#   https://{workspace_id}.cn-beijing.maas.aliyuncs.com
# The id looks like `llm-xxxxxxxx` (not `ws-...`) and is on the Model Studio
# console under 业务空间 -> 业务空间详情.
#
# Do NOT paste a placeholder into this. A wrong id becomes a hostname that does
# not resolve, and every DashScope call -- voice enrollment included -- then
# hangs until the timeout. That failure looks like "上游不可达", not like a typo.
DASHSCOPE_WORKSPACE_ID=

# Access password for the whole app. Leave empty to disable auth (not advised).
APP_PASSWORD=change-me

# Used to sign the session cookie. Falls back to APP_PASSWORD if unset.
SESSION_SECRET=

# Public origin of the deployment, used so DashScope can download voice-clone
# enrollment audio. Required for local storage (Render/Docker/bare host).
# On Vercel this is ignored unless you force STORAGE_BACKEND=local.
PUBLIC_BASE_URL=https://your-app.example.com

# auto | local | blob
#   auto  - Blob when BLOB_READ_WRITE_TOKEN is set or on Vercel, else local disk
#   local - temp dir served by GET /media/{name}; requires PUBLIC_BASE_URL
#   blob  - Vercel Blob, via the official `vercel` SDK
STORAGE_BACKEND=auto

# 音色列表是每次打开页面都会调的上游接口。它偶尔会卡住（Vercel 函数在东京、
# DashScope 在北京），所以超时时间可调：默认 20s 一般够用；如果延迟明显更高，
# 比如部署在新加坡，可以调到 45。
LIST_TIMEOUT_SECONDS=20
# 成功结果的缓存时长。调小可以让「刷新列表」之外的路径更常拿到新数据。
LIST_CACHE_SECONDS=60

# Only needed for STORAGE_BACKEND=blob. On Vercel you do not set this by hand:
# connect the Blob store to the project (Storage -> store -> Projects ->
# Connect to Project) and Vercel injects it into Production and Preview.
# The store MUST be Public: DashScope downloads the sample anonymously, and a
# private store rejects the upload. Access is fixed at creation time.
BLOB_READ_WRITE_TOKEN=

# Optional model overrides
FUN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanhuan

# ---- 文本标注用的 LLM（语音合成页的「AI 加情感标签」/「AI 写口播稿」）----
#
# 任何 OpenAI 兼容端点都可以：百炼 compatible-mode、DeepSeek、Kimi、GLM、
# OpenRouter、one-api 聚合网关、自建 vLLM。默认指向百炼，所以不填也能直接用
# 上面的 DASHSCOPE_API_KEY。改厂商只需要动这三行。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# id:显示名,id:显示名 —— 显示名只给前端下拉用，id 才是发给上游的。
LLM_MODELS=qwen-turbo:快速,qwen-plus:均衡
LLM_MODEL=qwen-turbo
# 上限是按最长档位（15 分钟约 3750 字）定的：中文约一 token 一字，3750 字成稿
# 要 4000+ token。这是上限不是预留，费用按实际生成计，调高不会多花钱。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=6000
LLM_TEMPERATURE=0.3
# 429（账号被限流）和 5xx 自动重试几次，退避按这个秒数翻倍。限流和上游抖动都是
# 瞬时的，通常一次就过去了。4xx（key 错、模型不存在）不重试，超时也不重试 ——
# 一次已经 120s，三次就撞穿 Vercel 300s 的函数预算。
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=3

# 一次标注的输入上限（字），跟着最长时长一起放宽，否则长稿只能写、不能标。
TAGS_MAX_CHARS=4000
# 标注接口的限流，防止刷接口烧 token。
TAGS_LIMIT_MAX_ATTEMPTS=20
TAGS_LIMIT_WINDOW_SECONDS=60
TAGS_LIMIT_LOCKOUT_SECONDS=120