# DashScope / Bailian credentials (https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=sk-your-key

# REQUIRED for the `sk-ws-` keys Bailian issues today, and optional only in
# principle. Voice enrollment (tab 6) is served from a per-workspace endpoint:
# the same call against dashscope.aliyuncs.com answers `ModelNotFound`, so
# leaving this empty costs you the whole voice-clone page. Speech synthesis and
# realtime chat work on either endpoint.
#
# The id looks like `llm-xxxxxxxx` and is on the Model Studio console under
# 业务空间 -> 业务空间详情.
#
# Do NOT paste a placeholder into this. A wrong id becomes a hostname that does
# not resolve, and every DashScope call -- voice enrollment included -- then
# hangs until the timeout. That failure looks like "上游不可达", not like a typo.
DASHSCOPE_WORKSPACE_ID=

# Access password for the whole app. Leave empty to disable auth (not advised).
APP_PASSWORD=change-me

# Used to sign the session cookie. Falls back to APP_PASSWORD if unset.
SESSION_SECRET=

# Public origin of the deployment, used so DashScope can download voice-clone
# enrollment audio. Required for local storage (Render/Docker/bare host).
# On Vercel this is ignored unless you force STORAGE_BACKEND=local.
PUBLIC_BASE_URL=https://your-app.example.com

# auto | local | blob | r2
#   auto  - Blob when BLOB_READ_WRITE_TOKEN is set or on Vercel, else local disk
#   local - temp dir served by GET /media/{name}; requires PUBLIC_BASE_URL
#   blob  - Vercel Blob, via the official `vercel` SDK
#   r2    - Cloudflare R2 object store; needs R2_PUBLIC_BUCKET_URL and the bucket
#           binding injected per-request (see cloudflare/). Workers-specific.
STORAGE_BACKEND=auto

# 音色列表是每次打开页面都会调的上游接口。它偶尔会卡住（Vercel 函数在东京、
# DashScope 在北京），所以超时时间可调：默认 20s 一般够用；如果延迟明显更高，
# 比如部署在新加坡，可以调到 45。
LIST_TIMEOUT_SECONDS=20
# 成功结果的缓存时长。调小可以让「刷新列表」之外的路径更常拿到新数据。
LIST_CACHE_SECONDS=60

# Only needed for STORAGE_BACKEND=blob. On Vercel you do not set this by hand:
# connect the Blob store to the project (Storage -> store -> Projects ->
# Connect to Project) and Vercel injects it into Production and Preview.
# The store MUST be Public: DashScope downloads the sample anonymously, and a
# private store rejects the upload. Access is fixed at creation time.
BLOB_READ_WRITE_TOKEN=
# Only needed for STORAGE_BACKEND=r2 (Cloudflare Workers). Public origin of the
# R2 bucket that serves voice-clone enrollment audio: a custom domain
# (preferred) or a public r2.dev URL. No trailing slash.
R2_PUBLIC_BUCKET_URL=


# Optional model overrides
FUN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanhuan

# 语音合成的上游 WebSocket 连接重试。SDK 每次固定等 5 秒且不可配置，所以能调
# 的只有「试几次、隔多久」。默认 3 次（0.5s 起指数退避，封顶 2s），最坏约
# 16.5 秒 —— 远低于 Vercel 的 300s 函数上限，又给跨境线路留了纠错机会。
# 只对连接超时重试；模型不存在、参数错误重试只会重复计费。
TTS_CONNECT_ATTEMPTS=3
TTS_CONNECT_BACKOFF_SECONDS=0.5
TTS_CONNECT_BACKOFF_MAX_SECONDS=2
TTS_CONNECT_JITTER_SECONDS=0.25
# 连接失败后做一次主动探测，判断卡在 DNS / TCP / TLS 哪一段，结果写进
# 浏览器调试抽屉的 debug.upstream_probe。只在失败路径执行；0 关闭。
TTS_PROBE_TIMEOUT_SECONDS=3

# ---- 文本标注用的 LLM（语音合成页的「AI 加情感标签」/「AI 写口播稿」）----
#
# 任何 OpenAI 兼容端点都可以：百炼 compatible-mode、DeepSeek、Kimi、GLM、
# OpenRouter、one-api 聚合网关、自建 vLLM。默认指向百炼，所以不填也能直接用
# 上面的 DASHSCOPE_API_KEY。改厂商只需要动这三行。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# id:显示名,id:显示名 —— 显示名只给前端下拉用，id 才是发给上游的。
#
# 默认只列实测调得通的两个，因为百炼现在签发的 Key 带模型白名单：不在名单里的
# 模型报的是 403 `AccessDenied: Access denied by API-Key restrictions.`，不是
# 「模型不存在」。实测同一把 `sk-ws-` Key 上 qwen3.8-flash / qwen3.7-flash 返回
# 200，而 qwen-flash / qwen-plus / qwen3.6-flash / qwen-max / deepseek-* /
# kimi-* / glm-* 一律 403 —— 也就是说下拉里摆一个调不通的模型，等于摆了个点了
# 就报错的选项。
#
# 白名单在 百炼控制台 → API-KEY 管理 → 选中这把 Key 配。放开后把更多
# `id:显示名` 追加进来即可，代码不用动。
#
# ⚠️ `GET /compatible-mode/v1/models` **不能**用来判断可用性：它返回全站目录，
# 不做白名单过滤，看着什么模型都有。
#
# 各模型单价（元 / 百万 token，华北2 北京，输入 ≤128K）：
#   qwen3.8-flash  0.8 / 2.7      qwen3.7-flash  0.15 / 1.5
# 每个模型各有 100 万 token 免费额度（开通后 90 天内），额度用完才按量计费。
LLM_MODELS=qwen3.8-flash:均衡,qwen3.7-flash:备用
LLM_MODEL=qwen3.8-flash
# 上限是按最长档位（15 分钟约 3750 字）定的：中文约一 token 一字，3750 字成稿
# 要 4000+ token。这是上限不是预留，费用按实际生成计，调高不会多花钱。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=6000
LLM_TEMPERATURE=0.3
# 429（账号被限流）和 5xx 自动重试几次，退避按这个秒数翻倍。
#
# 429 和 5xx 的等待时间必须分开：百炼的限流按**主账号**合并计算、通常一分钟内恢复，
# 还有一条「请求量突增触发了稳定性保护，即使 RPM/TPM 未超限」。被限流后 3 秒再打一次
# 只会加深限流，所以 429 只重试一次、且等 LLM_RATE_LIMIT_BACKOFF_SECONDS 那么久；
# 5xx 是对方服务抖动，按上面的秒数短退避重试几次。
#
# 4xx（key 错、模型不存在）不重试，超时也不重试 —— 一次已经 120s，三次就撞穿
# Vercel 300s 的函数预算。
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=3
LLM_RATE_LIMIT_BACKOFF_SECONDS=20

# 一次标注的输入上限（字），跟着最长时长一起放宽，否则长稿只能写、不能标。
TAGS_MAX_CHARS=4000
# 标注接口的本地限流。两个作用：防刷接口烧 token，以及不让自己的上游额度被自己
# 打爆 —— 百炼对 qwen-turbo 的限流按主账号合并计算，还叠加一层「请求量突增保护」，
# 所以这个数必须明显低于上游额度。正常用一次标注要好几秒，一分钟点 8 次已经不像人话。
TAGS_LIMIT_MAX_ATTEMPTS=8
TAGS_LIMIT_WINDOW_SECONDS=60
TAGS_LIMIT_LOCKOUT_SECONDS=120